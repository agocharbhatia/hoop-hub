# Copy to .env.beta at the repository root; keep server credentials off Git and out of the image.
# For a local Docker check use http://127.0.0.1:3000. For sharing use https://your-domain.example.
ORIGIN=http://127.0.0.1:3000
BETA_DOMAIN=your-domain.example
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=

# Confirm current prices for that exact model before enabling research.
HOOP_HUB_MODEL_PRICING_MODEL=
HOOP_HUB_MODEL_INPUT_USD_PER_MILLION=
HOOP_HUB_MODEL_OUTPUT_USD_PER_MILLION=
# Optional; guard defaults to 1.25 times full input price and never discounts cache hits.
HOOP_HUB_MODEL_CACHE_WRITE_USD_PER_MILLION=
HOOP_HUB_DAILY_BUDGET_USD=5
HOOP_HUB_USER_DAILY_BUDGET_USD=0.5
HOOP_HUB_QUERY_BUDGET_USD=0.15
HOOP_HUB_RESEARCH_PER_DAY=30
HOOP_HUB_RESEARCH_PER_MINUTE=5
HOOP_HUB_CONCURRENT_RESEARCH=4
HOOP_HUB_EXPORTS_PER_DAY=3

# These flags record operator-confirmed display permission; subscriptions alone do not establish it.
# Leave unconfirmed providers disabled until applicable terms/permission have been checked.
HOOP_HUB_NBA_PUBLIC_DISPLAY_ALLOWED=0
HOOP_HUB_PBPSTATS_PUBLIC_DISPLAY_ALLOWED=0
HOOP_HUB_ENABLE_LIVE_NBA=1
HOOP_HUB_ENABLE_LIVE_PBPSTATS=0
HOOP_HUB_NBA_TIMEOUT_MS=15000
# Optional server-only egress proxy if NBA Stats is inaccessible from the chosen host.
# HOOP_HUB_NBA_PROXY_URL=
