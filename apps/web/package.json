{
	"name": "web",
	"version": "0.0.1",
	"devDependencies": {
		"@internationalized/date": "^3.12.0",
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^25.3.0",
		"bits-ui": "^2.16.3",
		"svelte": "^5.51.0",
		"svelte-check": "^4.3.6",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"private": true,
	"scripts": {
		"dev": "node --env-file-if-exists=.env ./node_modules/vite/bin/vite.js dev",
		"build": "bun --bun vite build && bun ./scripts/package-server-assets.ts && NODE_ENV=production bun build ./scripts/start-server.ts --target=node --packages=external --outfile=./build/start-server.mjs && bun ./scripts/check-node-transport-build.ts",
		"preview": "HOOP_HUB_AUTH_MODE=local node --env-file-if-exists=.env ./node_modules/vite/bin/vite.js preview",
		"eval": "bun ./scripts/run-evals.ts --mode local",
		"eval:model": "bun ./scripts/run-evals.ts --mode model",
		"eval:live": "bun ./scripts/run-evals.ts --mode live",
		"eval:custom-shots": "HOOP_HUB_DB_PATH=:memory: HOOP_HUB_ENABLE_LIVE_NBA=0 bun test ./eval/custom-shot-video.eval.test.ts",
		"nightly:bootstrap": "bun ./scripts/nightly-bootstrap.ts",
		"nightly:audit": "bun ./scripts/nightly-audit.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:endpoint-catalog-contracts": "bun ./scripts/check-endpoint-catalog-contracts.ts",
		"check:node-transport-build": "bun ./scripts/check-node-transport-build.ts",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "HOOP_HUB_DB_PATH=:memory: HOOP_HUB_ENABLE_LIVE_NBA=0 HOOP_HUB_ENABLE_LIVE_PBPSTATS=0 bun test ./src",
		"test:planner-smoke": "bun test ./smoke/query-acceptance.smoke.test.ts",
		"test:live-smoke": "bun test ./smoke/live-player-resolution.smoke.test.ts",
		"start": "node ./build/start-server.mjs",
		"beta:admin": "bun ./scripts/beta-admin.ts",
		"beta:smoke": "bun ./scripts/beta-smoke.ts",
		"beta:container-smoke": "bun ./scripts/beta-container-smoke.ts"
	},
	"type": "module",
	"dependencies": {
		"@fontsource-variable/geist": "^5.2.8",
		"@tabler/icons-svelte": "^3.41.1",
		"clsx": "^2.1.1",
		"openai": "^6.33.0",
		"shadcn-svelte": "^1.2.7",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tw-animate-css": "^1.4.0"
	}
}
