# Lower-bound season for "modern era" coverage.
# Format: YYYY-YY
MODERN_ERA_START_SEASON=1996-97

# Planner runtime:
# OPENAI_API_KEY=
# OPENAI_AGENT_MODEL=
# OPENAI_PLANNER_MODEL=
# OPENAI_ANSWER_RENDERER_MODEL=

# Optional SQLite path override for data/cache persistence.
# Use ':memory:' for ephemeral test runs.
# By default, Hoop Hub stores a per-worktree DB under ~/.hoop-hub/data/<hash>/hoop-hub.sqlite
# HOOP_HUB_DB_PATH=/absolute/path/to/hoop-hub.sqlite

# Enable live fetches against stats.nba.com.
# Set to 0, false, or off to force cache-only behavior.
# HOOP_HUB_ENABLE_LIVE_NBA=1

# PBP Stats possession/lineup adapter; no API key is required.
# HOOP_HUB_ENABLE_LIVE_PBPSTATS=1
# Internal research is the default. Set public when deploying for other users.
# HOOP_HUB_DATA_USE=internal
# Only enable public PBP Stats display after obtaining the necessary rights.
# HOOP_HUB_PBPSTATS_PUBLIC_DISPLAY_ALLOWED=0

# Optional timeout for live NBA requests in milliseconds.
# Defaults to 5000.
# HOOP_HUB_NBA_TIMEOUT_MS=5000

# Optional proxy for live stats.nba.com requests.
# Takes precedence over HTTPS_PROXY / HTTP_PROXY when set.
# HOOP_HUB_NBA_PROXY_URL=http://username:password@proxy.example.com:8080
# HOOP_HUB_NBA_PROXY_URL=proxy-host:port:username:password
# HOOP_HUB_NBA_PROXY_URL=proxy-one.example:8080:user:pass
# proxy-two.example:8080:user:pass

# Paid evals require an explicit ceiling and current model input/output rates.
# Cached/write rates are optional; omission estimates conservatively.
# Example GPT-6 Luna standard rates verified 2026-10-02 (USD per million tokens):
# HOOP_HUB_EVAL_BUDGET_USD=0.25
# HOOP_HUB_EVAL_INPUT_COST_PER_MILLION=0.1
# HOOP_HUB_EVAL_OUTPUT_COST_PER_MILLION=0.5
# HOOP_HUB_EVAL_CACHED_INPUT_COST_PER_MILLION=0.01
# HOOP_HUB_EVAL_CACHE_WRITE_COST_PER_MILLION=0.125
# Minimum paid-eval call interval; defaults to 4000 ms. Rate-limit retries are bounded.
# HOOP_HUB_EVAL_MIN_CALL_INTERVAL_MS=4000
